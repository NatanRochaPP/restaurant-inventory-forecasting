# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Office / OneDrive lock files
~$*

# Note: data/ and outputs/ are committed on purpose as reproducible evidence.
# To keep the repo lean instead, uncomment the next two lines:
# data/*.csv
# outputs/*.png

# Generated artefacts: both are rebuilt by scripts/train_models.py and
# scripts/run_simulation.py, so they are not tracked.
data/*.db
models/*.joblib

# Report-writing tools: kept locally, not part of the application
scripts/generate_dissertation_draft.py
scripts/literature_text.py
scripts/reflection_text.py
scripts/references.py
scripts/citations.py
scripts/architecture_diagram.py
scripts/capture_dashboard.py
tests/test_dissertation_draft.py
tests/test_references.py
tests/test_citations.py
docs/search_log.csv
docs/*.docx

# Pipeline run logs are per-run, not evidence.
outputs/logs/

# Report figures and tables: scripts/run_all.py (or generate_report_figures.py)
# rebuilds all of them from the CSVs in outputs/, so they are not tracked.
outputs/report/

# Outputs of baseline_forecasting.py: rewritten on every run and not read by the
# pipeline.
outputs/fig1_weekly_seasonality.png
outputs/fig2_holiday_spikes.png
outputs/fig3_forecast_vs_actual.png
outputs/fig4_gantt.png
outputs/results_summary.json
outputs/results_table.csv
