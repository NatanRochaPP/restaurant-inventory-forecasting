# Python caches, created when the code or the tests run
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment created by the setup steps in README.md
.venv/

# SQLite database (data.database in config/config.yaml) and the trained model
# (scripts/train_models.py), both rebuilt by the pipeline
data/*.db
models/*.joblib

# Written by scripts/run_all.py: run logs, and the figures and tables rebuilt from
# the CSVs in outputs/
outputs/logs/
outputs/report/

# Written by baseline_forecasting.py on every run and not read by the pipeline
outputs/fig1_weekly_seasonality.png
outputs/fig2_holiday_spikes.png
outputs/fig3_forecast_vs_actual.png
outputs/fig4_gantt.png
outputs/results_summary.json
outputs/results_table.csv
